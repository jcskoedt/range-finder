# Vercel does not read .gitignore — without this file the entire directory is
# uploaded, and a single file over 100MB fails the deploy outright.

# Local-only working files, never served
.git/
.gstack/
.design-audit/
screenshots/
*.md
.DS_Store

# Not part of the deploy: applied by hand in Supabase, design docs, and the
# MCP server config, which is a local tool setting and not a served asset.
supabase/
docs/
.mcp.json

# Source assets that no route in vercel.json points at
RANGE_FINDER_LOGO.png
icon-1024.png
